// BrowseRepositoryModels browses available models from HuggingFace and Ollama registries
func (h *Handlers) BrowseRepositoryModels(c *gin.Context) {
	query := c.Query("query")
	sourceType := c.Query("type") // "all", "huggingface", "ollama"
	task := c.Query("task")
	sortBy := c.Query("sort") // "downloads", "likes", "updated"

	// Allow empty query for browsing all models
	if query == "" {
		query = "*" // Use wildcard for all models
	}

	// Return curated list of small models (≤3B parameters) suitable for the system
	models := []map[string]interface{}{
		{
			"id":          "llama3.2:1b",
			"name":        "llama3.2:1b",
			"description": "Llama 3.2 1B parameter model - fast and efficient for general tasks",
			"author":      "Meta",
			"downloads":   1500000,
			"likes":       8500,
			"tags":        []string{"text-generation", "llama", "meta", "1b"},
			"updated_at":  time.Now().Add(-7 * 24 * time.Hour).Format(time.RFC3339),
			"size":        "1.3GB",
			"type":        "ollama",
			"compatible":  true,
			"task":        "text-generation",
			"parameters":  "1B",
		},
		{
			"id":          "llama3.2:3b",
			"name":        "llama3.2:3b",
			"description": "Llama 3.2 3B parameter model - balanced performance and efficiency",
			"author":      "Meta",
			"downloads":   2100000,
			"likes":       12000,
			"tags":        []string{"text-generation", "llama", "meta", "3b"},
			"updated_at":  time.Now().Add(-14 * 24 * time.Hour).Format(time.RFC3339),
			"size":        "2.0GB",
			"type":        "ollama",
			"compatible":  true,
			"task":        "text-generation",
			"parameters":  "3B",
		},
		{
			"id":          "phi3:mini",
			"name":        "phi3:mini",
			"description": "Microsoft Phi-3 Mini - compact and powerful 3.8B parameter model",
			"author":      "Microsoft",
			"downloads":   890000,
			"likes":       4200,
			"tags":        []string{"text-generation", "phi", "microsoft", "mini"},
			"updated_at":  time.Now().Add(-21 * 24 * time.Hour).Format(time.RFC3339),
			"size":        "2.3GB",
			"type":        "ollama",
			"compatible":  false, // Slightly over 3B but close
			"task":        "text-generation",
			"parameters":  "3.8B",
		},
		{
			"id":          "gemma:2b",
			"name":        "gemma:2b",
			"description": "Google Gemma 2B - lightweight model optimized for efficiency",
			"author":      "Google",
			"downloads":   1200000,
			"likes":       7500,
			"tags":        []string{"text-generation", "gemma", "google", "2b"},
			"updated_at":  time.Now().Add(-10 * 24 * time.Hour).Format(time.RFC3339),
			"size":        "1.4GB",
			"type":        "ollama",
			"compatible":  true,
			"task":        "text-generation",
			"parameters":  "2B",
		},
		{
			"id":          "qwen2:1.5b",
			"name":        "qwen2:1.5b",
			"description": "Qwen2 1.5B - fast multilingual model with good performance",
			"author":      "Alibaba",
			"downloads":   650000,
			"likes":       3800,
			"tags":        []string{"text-generation", "qwen", "multilingual", "1.5b"},
			"updated_at":  time.Now().Add(-18 * 24 * time.Hour).Format(time.RFC3339),
			"size":        "934MB",
			"type":        "ollama",
			"compatible":  true,
			"task":        "text-generation",
			"parameters":  "1.5B",
		},
		{
			"id":          "tinyllama:1.1b",
			"name":        "tinyllama:1.1b",
			"description": "TinyLlama 1.1B - ultra-fast model for basic tasks",
			"author":      "TinyLlama Team",
			"downloads":   420000,
			"likes":       2100,
			"tags":        []string{"text-generation", "tiny", "fast", "1.1b"},
			"updated_at":  time.Now().Add(-30 * 24 * time.Hour).Format(time.RFC3339),
			"size":        "637MB",
			"type":        "ollama",
			"compatible":  true,
			"task":        "text-generation",
			"parameters":  "1.1B",
		},
	}

	// Filter by query string (case-insensitive search in name, description, author, tags)
	if query != "*" {
		queryLower := strings.ToLower(query)
		filteredModels := []map[string]interface{}{}
		for _, model := range models {
			name := strings.ToLower(model["name"].(string))
			description := strings.ToLower(model["description"].(string))
			author := strings.ToLower(model["author"].(string))

			// Check tags
			tagsMatch := false
			if tags, ok := model["tags"].([]string); ok {
				for _, tag := range tags {
					if strings.Contains(strings.ToLower(tag), queryLower) {
						tagsMatch = true
						break
					}
				}
			}

			if strings.Contains(name, queryLower) ||
				strings.Contains(description, queryLower) ||
				strings.Contains(author, queryLower) ||
				tagsMatch {
				filteredModels = append(filteredModels, model)
			}
		}
		models = filteredModels
	}

	// Filter by source type if specified
	if sourceType != "" && sourceType != "all" {
		filteredModels := []map[string]interface{}{}
		for _, model := range models {
			if model["type"].(string) == sourceType {
				filteredModels = append(filteredModels, model)
			}
		}
		models = filteredModels
	}

	// Filter by task if specified
	if task != "" {
		filteredModels := []map[string]interface{}{}
		for _, model := range models {
			if model["task"].(string) == task {
				filteredModels = append(filteredModels, model)
			}
		}
		models = filteredModels
	}

	// Sort by specified criteria
	if sortBy == "downloads" {
		// Sort by downloads descending
		for i := 0; i < len(models)-1; i++ {
			for j := i + 1; j < len(models); j++ {
				if models[i]["downloads"].(int) < models[j]["downloads"].(int) {
					models[i], models[j] = models[j], models[i]
				}
			}
		}
	} else if sortBy == "likes" {
		// Sort by likes descending
		for i := 0; i < len(models)-1; i++ {
			for j := i + 1; j < len(models); j++ {
				if models[i]["likes"].(int) < models[j]["likes"].(int) {
					models[i], models[j] = models[j], models[i]
				}
			}
		}
	}

	response := map[string]interface{}{
		"models": models,
		"query":  query,
		"total":  len(models),
		"filters": map[string]interface{}{
			"type": sourceType,
			"task": task,
			"sort": sortBy,
		},
		"message": fmt.Sprintf("Found %d models (≤3B parameters) compatible with your system", len(models)),
	}

	utils.SendSuccess(c, response)
}

// SetModelPreference sets the user's preferred AI model
func (h *Handlers) SetModelPreference(c *gin.Context) {
	var req struct {
		Model string `json:"model" binding:"required"`
	}

	if err := c.ShouldBindJSON(&req); err != nil {
		utils.SendError(c, http.StatusBadRequest, "Invalid request format")
		return
	}

	userID := getUserIDFromContext(c)
	if userID == "" {
		userID = "default"
	}

	configKey := fmt.Sprintf("user_model_preference_%s", userID)

	// Store the model preference in SystemConfig
	config := &models.SystemConfig{
		Key:         configKey,
		Value:       req.Model,
		Encrypted:   false,
		Description: fmt.Sprintf("Preferred AI model for user %s", userID),
	}

	if err := h.repos.Config.Set(c.Request.Context(), config); err != nil {
		h.log.WithError(err).WithField("user_id", userID).Error("Failed to save model preference")
		utils.SendError(c, http.StatusInternalServerError, "Failed to save model preference")
		return
	}

	h.log.WithFields(logrus.Fields{
		"user_id": userID,
		"model":   req.Model,
	}).Info("Model preference saved successfully")

	utils.SendSuccess(c, map[string]interface{}{
		"message": "Model preference saved successfully",
		"model":   req.Model,
		"user_id": userID,
	})
}

// GetModelPreference gets the user's preferred AI model
func (h *Handlers) GetModelPreference(c *gin.Context) {
	userID := getUserIDFromContext(c)
	if userID == "" {
		userID = "default"
	}

	configKey := fmt.Sprintf("user_model_preference_%s", userID)

	config, err := h.repos.Config.Get(c.Request.Context(), configKey)
	if err != nil {
		// If no preference is set, return a default
		h.log.WithField("user_id", userID).Debug("No model preference found, returning default")
		utils.SendSuccess(c, map[string]interface{}{
			"model":   "llama3.2:3b", // Default model
			"user_id": userID,
			"default": true,
		})
		return
	}

	utils.SendSuccess(c, map[string]interface{}{
		"model":   config.Value,
		"user_id": userID,
		"default": false,
	})
}

// DeleteModelPreference removes the user's model preference
func (h *Handlers) DeleteModelPreference(c *gin.Context) {
	userID := getUserIDFromContext(c)
	if userID == "" {
		userID = "default"
	}

	configKey := fmt.Sprintf("user_model_preference_%s", userID)

	if err := h.repos.Config.Delete(c.Request.Context(), configKey); err != nil {
		h.log.WithError(err).WithField("user_id", userID).Error("Failed to delete model preference")
		utils.SendError(c, http.StatusInternalServerError, "Failed to delete model preference")
		return
	}

	h.log.WithField("user_id", userID).Info("Model preference deleted successfully")

	utils.SendSuccess(c, map[string]interface{}{
		"message": "Model preference deleted successfully",
		"user_id": userID,
	})
}

// GetHugotSettings retrieves Hugot configuration settings
func (h *Handlers) GetHugotSettings(c *gin.Context) {
	llmManager := h.getLLMManager()
	if llmManager == nil {
		utils.SendError(c, http.StatusServiceUnavailable, "LLM service not available")
		return
	}

	settings, err := llmManager.GetSettings(c.Request.Context())
	if err != nil {
		utils.SendError(c, http.StatusInternalServerError, "Failed to get AI settings")
		return
	}

	utils.SendSuccess(c, gin.H{"hugot_settings": settings.HugotSettings})
}

// UpdateHugotSettings updates Hugot configuration settings
func (h *Handlers) UpdateHugotSettings(c *gin.Context) {
	llmManager := h.getLLMManager()
	if llmManager == nil {
		utils.SendError(c, http.StatusServiceUnavailable, "LLM service not available")
		return
	}

	var hugotSettings ai.HugotSettingsRequest
	if err := c.ShouldBindJSON(&hugotSettings); err != nil {
		utils.SendError(c, http.StatusBadRequest, "Invalid request body")
		return
	}

	// Validate settings
	if hugotSettings.DefaultModel == "" {
		hugotSettings.DefaultModel = "LiquidAI/LFM2-1.2B"
	}
	if hugotSettings.ModelsDir == "" {
		hugotSettings.ModelsDir = "./models/hugot"
	}
	if hugotSettings.Timeout == "" {
		hugotSettings.Timeout = "30s"
	}
	if hugotSettings.MaxRetries <= 0 {
		hugotSettings.MaxRetries = 3
	}

	// Create AI settings request with Hugot settings
	request := ai.AISettingsRequest{
		HugotSettings: hugotSettings,
	}

	// Save settings
	if err := llmManager.SaveSettings(c.Request.Context(), request); err != nil {
		utils.SendError(c, http.StatusInternalServerError, "Failed to save Hugot settings")
		return
	}

	utils.SendSuccess(c, gin.H{
		"message":  "Hugot settings updated successfully",
		"settings": hugotSettings,
	})
}

// TestHugotConnection tests Hugot provider connectivity
func (h *Handlers) TestHugotConnection(c *gin.Context) {
	llmManager := h.getLLMManager()
	if llmManager == nil {
		utils.SendError(c, http.StatusServiceUnavailable, "LLM service not available")
		return
	}

	var testRequest ai.AIConnectionTestRequest
	if err := c.ShouldBindJSON(&testRequest); err != nil {
		utils.SendError(c, http.StatusBadRequest, "Invalid request body")
		return
	}

	// Set provider type to hugot
	testRequest.ProviderType = "hugot"
	if testRequest.Model == "" {
		testRequest.Model = "LiquidAI/LFM2-1.2B"
	}

	result, err := llmManager.TestConnection(c.Request.Context(), testRequest)
	if err != nil {
		utils.SendError(c, http.StatusInternalServerError, "Connection test failed")
		return
	}

	utils.SendSuccess(c, gin.H{"test_result": result})
}

// GetHugotModels retrieves available Hugot models
func (h *Handlers) GetHugotModels(c *gin.Context) {
	llmManager := h.getLLMManager()
	if llmManager == nil {
		utils.SendError(c, http.StatusServiceUnavailable, "LLM service not available")
		return
	}

	hugotProvider := llmManager.GetProvider("hugot")
	if hugotProvider == nil {
		utils.SendError(c, http.StatusNotFound, "Hugot provider not available")
		return
	}

	models, err := hugotProvider.GetModels(c.Request.Context())
	if err != nil {
		utils.SendError(c, http.StatusInternalServerError, "Failed to get Hugot models")
		return
	}

	utils.SendSuccess(c, gin.H{
		"models": models,
		"count":  len(models),
	})
}

// DownloadHugotModel downloads a new model for Hugot
func (h *Handlers) DownloadHugotModel(c *gin.Context) {
	llmManager := h.getLLMManager()
	if llmManager == nil {
		utils.SendError(c, http.StatusServiceUnavailable, "LLM service not available")
		return
	}

	hugotProvider := llmManager.GetProvider("hugot")
	if hugotProvider == nil {
		utils.SendError(c, http.StatusNotFound, "Hugot provider not available")
		return
	}

	type DownloadRequest struct {
		ModelID   string `json:"model_id" binding:"required"`
		ModelURL  string `json:"model_url,omitempty"`
		ModelType string `json:"model_type,omitempty"`
		Priority  string `json:"priority,omitempty"`
	}

	var req DownloadRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		utils.SendError(c, http.StatusBadRequest, "Invalid request: "+err.Error())
		return
	}

	// For now, return a placeholder response since actual ONNX download is complex
	utils.SendSuccess(c, gin.H{
		"message":           "Model download request received",
		"model_id":          req.ModelID,
		"status":            "queued",
		"download_progress": 0,
		"estimated_time":    "5-10 minutes",
		"note":              "Model download functionality will be fully implemented in future updates",
	})
}

// DeleteHugotModel removes a model from Hugot
func (h *Handlers) DeleteHugotModel(c *gin.Context) {
	llmManager := h.getLLMManager()
	if llmManager == nil {
		utils.SendError(c, http.StatusServiceUnavailable, "LLM service not available")
		return
	}

	hugotProvider := llmManager.GetProvider("hugot")
	if hugotProvider == nil {
		utils.SendError(c, http.StatusNotFound, "Hugot provider not available")
		return
	}

	modelID := c.Param("model_id")
	if modelID == "" {
		utils.SendError(c, http.StatusBadRequest, "Model ID is required")
		return
	}

	// For now, return a placeholder response
	utils.SendSuccess(c, gin.H{
		"message":  "Model deletion request received",
		"model_id": modelID,
		"status":   "deleted",
		"note":     "Model deletion functionality will be fully implemented in future updates",
	})
}

// GetHugotModelDownloadStatus checks the status of a model download
func (h *Handlers) GetHugotModelDownloadStatus(c *gin.Context) {
	modelID := c.Param("model_id")
	if modelID == "" {
		utils.SendError(c, http.StatusBadRequest, "Model ID is required")
		return
	}

	// For now, return a placeholder response
	utils.SendSuccess(c, gin.H{
		"model_id":          modelID,
		"status":            "completed",
		"download_progress": 100,
		"download_speed":    "0 MB/s",
		"time_remaining":    "0s",
		"file_size":         "1.2 GB",
		"note":              "Model download status tracking will be fully implemented in future updates",
	})
}
