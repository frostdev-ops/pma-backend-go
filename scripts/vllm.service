[Unit]
Description=vLLM Server for LiquidAI LFM2-1.2B
Documentation=https://docs.vllm.ai/
After=network.target
Wants=network.target

[Service]
Type=simple
User=pma
Group=pma
WorkingDirectory=/opt/pma/backend
Environment=PYTHONPATH=/opt/pma/backend/.venv/lib/python3.11/site-packages
Environment=PATH=/opt/pma/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=CUDA_VISIBLE_DEVICES=0
Environment=VLLM_LOGGING_LEVEL=INFO
Environment=TOKENIZERS_PARALLELISM=false
Environment=HF_HOME=/opt/pma/models/huggingface
Environment=TRANSFORMERS_CACHE=/opt/pma/models/huggingface

# Command to start vLLM server
ExecStart=/opt/pma/backend/.venv/bin/python -m vllm.entrypoints.openai.api_server \
    --model LiquidAI/LFM2-1.2B \
    --host 127.0.0.1 \
    --port 8000 \
    --served-model-name LFM2-1.2B \
    --dtype auto \
    --max-model-len 2048 \
    --max-num-batched-tokens 2048 \
    --max-num-seqs 1 \
    --tensor-parallel-size 1 \
    --pipeline-parallel-size 1 \
    --gpu-memory-utilization 0.6 \
    --swap-space 2 \
    --enforce-eager \
    --disable-log-requests

# Health check script
ExecStartPre=/bin/bash -c 'timeout 10 /opt/pma/backend/.venv/bin/python -c "import vllm; print(\\"vLLM available\\")"'

# Graceful shutdown
ExecStop=/bin/kill -TERM $MAINPID
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM

# Restart configuration
Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
OOMScoreAdjust=-100

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pma /var/log /tmp

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vllm

[Install]
WantedBy=multi-user.target